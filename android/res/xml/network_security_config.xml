<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (plain HTTP) is only permitted to the hosts TripTrack is actually meant
  to talk to — the production server and known local/dev addresses — not globally,
  the way android:usesCleartextTraffic="true" would allow. Pointing a dev build at a
  new LAN address (see MainActivity's server_url override) means adding that host
  here and rebuilding, rather than re-enabling cleartext for every host.
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">116.74.77.22</domain>
    <domain includeSubdomains="false">192.168.2.103</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
  </domain-config>
</network-security-config>
